{
  "HanASM 程序入口": {
    "prefix": [
      "main",
      "入口"
    ],
    "body": [
      "入口:",
      "\t$0",
      "\t停"
    ],
    "description": "生成程序入口标签与结束指令"
  },
  "HanASM 装入（赋值）": {
    "prefix": [
      "mov",
      "装"
    ],
    "body": [
      "装 ${1:甲}, ${2:0}"
    ],
    "description": "把立即数、变量或另一个寄存器的值装入寄存器"
  },
  "HanASM 加法": {
    "prefix": [
      "add",
      "加"
    ],
    "body": [
      "加 ${1:甲}, ${2:1}"
    ],
    "description": "寄存器加上操作数，结果写回寄存器"
  },
  "HanASM 比较并跳转": {
    "prefix": [
      "cmp",
      "比较"
    ],
    "body": [
      "比较 ${1:甲}, ${2:乙}",
      "跳${3|等,不等,大于,小于,零,正,负|} ${4:标签}"
    ],
    "description": "比较两个操作数，并按条件跳转"
  },
  "HanASM 无条件跳转": {
    "prefix": [
      "jmp",
      "跳转"
    ],
    "body": [
      "跳 ${1:标签}"
    ],
    "description": "无条件跳转到指定标签"
  },
  "HanASM 打印": {
    "prefix": [
      "print",
      "打印"
    ],
    "body": [
      "打印 ${1:甲}"
    ],
    "description": "输出寄存器或变量的内容"
  },
  "HanASM 数据定义": {
    "prefix": [
      "data",
      "数据"
    ],
    "body": [
      "${1:消息}: ${2|整数,字符,字串|} ${3:0}"
    ],
    "description": "定义带类型的数据（整数 / 字符 / 字串）"
  },
  "HanASM 程序骨架": {
    "prefix": [
      "seg",
      "骨架"
    ],
    "body": [
      "数据段",
      "",
      "${1:消息}: 字串 \"你好，世界\\n\"",
      "",
      "代码段",
      "",
      "入口:",
      "\t装 甲, ${1:消息}",
      "\t打印 甲",
      "",
      "\t停"
    ],
    "description": "生成包含数据段与代码段的完整程序骨架"
  },
  "HanASM 计数循环": {
    "prefix": [
      "loop",
      "循环"
    ],
    "body": [
      "\t装 乙, 0",
      "${1:循环开始}:",
      "\t比较 乙, ${2:10}",
      "\t跳等 ${3:循环结束}",
      "\t$0",
      "\t自增 乙",
      "\t跳 ${1:循环开始}",
      "${3:循环结束}:"
    ],
    "description": "用比较 + 条件跳转实现的计数循环"
  }
}